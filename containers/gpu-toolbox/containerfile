# gpu-toolbox: Intel Arc Pro B70 diagnostics + VA-API/FFmpeg toolbox
#
# Intel Arc Pro B70 (Battlemage / Xe2) diagnostics container with hardware-
# accelerated FFmpeg (VA-API + oneVPL/QSV) for encoding/transcoding.
#
# FFmpeg: jellyfin-ffmpeg7 (Resolute-native deb, self-contained libva+iHD)
# Drivers: kobuk-team/intel-graphics PPA (official Intel compute runtime channel)

## Builder: download jellyfin-ffmpeg7 deb (self-contained, version-pinned)
FROM ubuntu:26.04 AS builder

# renovate: datasource=generic depName=jellyfin-ffmpeg7 versioning=semver
ARG JELLYFIN_FFMPEG_VERSION=7.1.4-3

RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates curl; \
  curl -fSL -o /tmp/jellyfin-ffmpeg.deb \
  "https://repo.jellyfin.org/files/ffmpeg/ubuntu/latest-7.x/amd64/jellyfin-ffmpeg7_${JELLYFIN_FFMPEG_VERSION}-resolute_amd64.deb"; \
  # Verify the deb contains the expected ffmpeg binary
  dpkg-deb -c /tmp/jellyfin-ffmpeg.deb | grep -q '/usr/lib/jellyfin-ffmpeg/ffmpeg'; \
  rm -rf /var/lib/apt/lists/*

## Final: Ubuntu 24.04 with Intel Arc Pro B70 drivers + FFmpeg
FROM ubuntu:26.04

LABEL org.opencontainers.image.source="https://github.com/ArthurVardevanyan/HomeLab" \
  org.opencontainers.image.title="GPU Toolbox (Intel Arc)" \
  org.opencontainers.image.description="Intel Arc Pro B70 diagnostics + hardware-accelerated FFmpeg (VA-API/QSV)" \
  org.opencontainers.image.licenses="MIT"

ENV LIBVA_DRIVER_NAME=iHD \
  LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri \
  XDG_CACHE_HOME=/tmp \
  MESA_SHADER_CACHE_DIR=/tmp

COPY --from=builder /tmp/jellyfin-ffmpeg.deb /tmp/jellyfin-ffmpeg.deb

RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
  ca-certificates curl gnupg software-properties-common; \
  # kobuk-team PPA for Intel Xe/Battlemage compute runtime (official Intel channel)
  add-apt-repository -y ppa:kobuk-team/intel-graphics; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
  # GPU diagnostics (stock Ubuntu)
  clinfo \
  intel-gpu-tools \
  mesa-vulkan-drivers \
  vulkan-tools \
  # kobuk-team PPA — Intel Xe/Battlemage drivers + tools
  intel-media-va-driver-non-free \
  intel-opencl-icd \
  libvpl2 \
  libvpl-tools \
  libze-intel-gpu1 \
  libze1 \
  vainfo \
  xpu-smi \
  # jellyfin-ffmpeg7 (pulls its own deps from Ubuntu repos)
  /tmp/jellyfin-ffmpeg.deb; \
  # Symlink ffmpeg/ffprobe into PATH
  ln -sf /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg; \
  ln -sf /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe; \
  # Verify hardware encoders are available (hard failure — no || true)
  ffmpeg -hide_banner -encoders 2>/dev/null | grep -qE 'h264_vaapi|hevc_vaapi|av1_vaapi'; \
  # Cleanup
  rm -rf /var/lib/apt/lists/* /tmp/* /var/cache/apt/*

CMD ["sleep", "infinity"]

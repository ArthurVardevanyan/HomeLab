# goreleaser, git-cliff, task, k8s-gitops-ci
# renovate: datasource=github-releases depName=goreleaser/goreleaser
ENV GORELEASER_VERSION=2.17.1
# renovate: datasource=github-releases depName=orhun/git-cliff
ENV GIT_CLIFF_VERSION=2.13.1
# renovate: datasource=github-releases depName=go-task/task
ENV TASK_VERSION=3.52.0
# renovate: datasource=github-releases depName=ArthurVardevanyan/k8s-gitops-ci
ENV K8S_GITOPS_CI_VERSION=0.54.1
RUN curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o "goreleaser_Linux_x86_64.tar.gz" \
  "https://github.com/goreleaser/goreleaser/releases/download/v${GORELEASER_VERSION}/goreleaser_Linux_x86_64.tar.gz" && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o goreleaser-checksums.txt \
  "https://github.com/goreleaser/goreleaser/releases/download/v${GORELEASER_VERSION}/checksums.txt" && \
  grep -E "goreleaser_Linux_x86_64\.tar\.gz$" goreleaser-checksums.txt | sha256sum -c - && \
  tar -xzf goreleaser_Linux_x86_64.tar.gz -C /usr/local/bin goreleaser && \
  chmod +x /usr/local/bin/goreleaser && rm -f goreleaser_Linux_x86_64.tar.gz goreleaser-checksums.txt && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o "git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
  "https://github.com/orhun/git-cliff/releases/download/v${GIT_CLIFF_VERSION}/git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz" && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o "git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz.sha512" \
  "https://github.com/orhun/git-cliff/releases/download/v${GIT_CLIFF_VERSION}/git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz.sha512" && \
  sha512sum -c "git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz.sha512" && \
  tar -xzf "git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz" --strip-components=1 -C /usr/local/bin "git-cliff-${GIT_CLIFF_VERSION}/git-cliff" && \
  chmod +x /usr/local/bin/git-cliff && rm -f "git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz" "git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz.sha512" && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o "task_linux_amd64.tar.gz" \
  "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_linux_amd64.tar.gz" && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o task_checksums.txt \
  "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_checksums.txt" && \
  grep -E "task_linux_amd64\.tar\.gz$" task_checksums.txt | sha256sum -c - && \
  tar -xzf task_linux_amd64.tar.gz -C /usr/local/bin task && \
  chmod +x /usr/local/bin/task && rm -f task_linux_amd64.tar.gz task_checksums.txt && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o "k8s-gitops-ci_${K8S_GITOPS_CI_VERSION}_linux_amd64.tar.gz" \
  "https://github.com/ArthurVardevanyan/k8s-gitops-ci/releases/download/v${K8S_GITOPS_CI_VERSION}/k8s-gitops-ci_${K8S_GITOPS_CI_VERSION}_linux_amd64.tar.gz" && \
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 -o k8s-gitops-ci_checksums.txt \
  "https://github.com/ArthurVardevanyan/k8s-gitops-ci/releases/download/v${K8S_GITOPS_CI_VERSION}/k8s-gitops-ci_${K8S_GITOPS_CI_VERSION}_checksums.txt" && \
  grep -E "k8s-gitops-ci_${K8S_GITOPS_CI_VERSION}_linux_amd64\.tar\.gz$" k8s-gitops-ci_checksums.txt | sha256sum -c - && \
  tar -xzf "k8s-gitops-ci_${K8S_GITOPS_CI_VERSION}_linux_amd64.tar.gz" --no-same-owner -C /usr/local/bin k8s-gitops-ci && \
  chmod +x /usr/local/bin/k8s-gitops-ci && rm -f "k8s-gitops-ci_${K8S_GITOPS_CI_VERSION}_linux_amd64.tar.gz" k8s-gitops-ci_checksums.txt

RUN golangci-lint --version
CMD ["sleep", "infinity"]

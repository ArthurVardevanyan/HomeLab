[Unit]
Description=MicroShift BootC Entrypoint Service
Documentation=https://github.com/microshift-io/microshift
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
Environment=CONTAINER_NAME=microshift-okd
Environment=LVM_DISK=/var/lib/microshift-okd/lvmdisk.image
Environment=LVM_VOLSIZE=100G
Environment=VG_NAME=myvg1
Environment=EXTRA_CONFIG=/var/lib/microshift-okd/custom_config.yaml
Environment=DOMAIN=microshift.dc2.vardevanyan.com
Environment=API_SERVER_PORT=6443
Environment=KUBECONFIG=/var/lib/microshift/resources/kubeadmin/kubeconfig
Environment=LAST_IMAGE_FILE=/var/lib/microshift-okd/.last_image
Environment=COCKPIT=0
ExecStartPre=/usr/local/bin/microshift-entrypoint.sh
ExecStart=/usr/local/bin/microshift-entrypoint.sh
ExecStop=-/usr/bin/systemctl stop microshift.service
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

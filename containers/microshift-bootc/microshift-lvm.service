[Unit]
Description=Provision TopoLVM loop-backed volume group for MicroShift
Documentation=file:///usr/local/bin/setup-lvm.sh
After=local-fs.target systemd-udevd.service
Before=microshift.service
RequiresMountsFor=/var/lib/microshift-okd
ConditionPathExists=/usr/lib/microshift/manifests.d/001-microshift-topolvm

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/setup-lvm.sh

[Install]
WantedBy=microshift.service

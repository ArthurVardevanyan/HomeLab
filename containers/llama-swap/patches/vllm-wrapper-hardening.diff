+// daemonPIDFile returns the path to the pidfile that records the vLLM daemon
+// PID. The wrapper writes it when it starts a daemon so a later invocation
+// can find and terminate a stale/broken daemon on a failed wake.
+func daemonPIDFile(vllmURL string) string {
+	dir := os.Getenv("VLLM_CACHE_ROOT")
+	if dir == "" {
+		dir = "/tmp"
+	}
+	return filepath.Join(dir, fmt.Sprintf("vllm-daemon-%s.pid", daemonPort(vllmURL)))
+}
+
+func daemonPort(vllmURL string) string {
+	if u, err := url.Parse(vllmURL); err == nil && u.Port() != "" {
+		return u.Port()
+	}
+	return "0"
+}
+
+// recordDaemonPID writes the PID and the daemon's executable path to the
+// pidfile so a later invocation can match and terminate a stale daemon.
+func recordDaemonPID(startArgs []string, vllmURL string, pid int) error {
+	data := fmt.Sprintf("%d\n%s\n", pid, startArgs[0])
+	pidFile := daemonPIDFile(vllmURL)
+	if err := os.MkdirAll(filepath.Dir(pidFile), 0755); err != nil {
+		return fmt.Errorf("failed to create pidfile dir: %w", err)
+	}
+	if err := os.WriteFile(pidFile, []byte(data), 0644); err != nil {
+		return err
+	}
+	return nil
+}
+
+// coldRestartDaemon terminates any stale daemon recorded in the pidfile (matched
+// by exact PID + cmdline verification to prevent accidental kills) and starts a
+// fresh daemon. It returns nil on success or an error if the fresh daemon could
+// not become healthy.
+func coldRestartDaemon(startArgs []string, vllmURL, healthPath string, waitTimeout time.Duration) error {
+	pidFile := daemonPIDFile(vllmURL)
+
+	// Read the recorded PID and command.
+	data, err := os.ReadFile(pidFile)
+	if err == nil {
+		lines := strings.SplitN(strings.TrimSpace(string(data)), "\n", 2)
+		if len(lines) >= 2 {
+			if pid, err := strconv.Atoi(strings.TrimSpace(lines[0])); err == nil && pid > 0 {
+				// Verify the process exists and its cmdline matches the recorded
+				// executable. This prevents killing a PID that was reused by
+				// an unrelated process.
+				if cmd, err := os.ReadFile(fmt.Sprintf("/proc/%d/cmdline", pid)); err == nil {
+					current := strings.ReplaceAll(string(cmd), "\x00", " ")
+					recordedCmd := strings.TrimSpace(lines[1])
+					if filepath.Base(strings.Fields(current)[0]) == filepath.Base(recordedCmd) {
+						// Kill the whole process group (daemon + EngineCore).
+						if err := syscall.Kill(-pid, syscall.SIGKILL); err == nil {
+							log.Printf("Killed stale daemon group PID %d (cmdline match)", pid)
+						}
+						// Brief wait so the port becomes available.
+						time.Sleep(500 * time.Millisecond)
+					}
+				}
+			}
+		}
+		_ = os.Remove(pidFile)
+	}
+
+	// Start a fresh daemon (cold restart).
+	log.Printf("Starting fresh daemon (cold restart)")
+	return startDaemon(startArgs, vllmURL, healthPath, waitTimeout)
+}

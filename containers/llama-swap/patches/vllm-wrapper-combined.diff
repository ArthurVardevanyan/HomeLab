+// tailLogFile tails the log file from startOffset and writes new lines to os.Stdout.
+// It polls the file every 100ms and exits when stopCh is closed.
+// If the file is truncated, it restarts from offset 0.
+func tailLogFile(filePath string, startOffset int64, stopCh <-chan struct{}) {
+	var offset = startOffset
+	var fileSize int64 = startOffset
+
+	// Open the log file.
+	file, err := os.OpenFile(filePath, os.O_RDONLY, 0644)
+	if err != nil {
+		log.Printf("Warning: failed to open log file %s: %v", filePath, err)
+		return
+	}
+	defer file.Close()
+
+	// Seek to the start offset.
+	if _, err := file.Seek(offset, 0); err != nil {
+		log.Printf("Warning: failed to seek to offset %d: %v", offset, err)
+		return
+	}
+
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-stopCh:
+			return
+		case <-ticker.C:
+			// Get current file size.
+			info, err := file.Stat()
+			if err != nil {
+				continue
+			}
+			fileSize = info.Size()
+
+			// If file was truncated (smaller than our offset), restart from 0.
+			if fileSize < offset {
+				offset = 0
+				if _, err := file.Seek(0, 0); err != nil {
+					continue
+				}
+				fileSize = 0
+			}
+
+			// If file has grown, read new content.
+			if fileSize > offset {
+				newBytes := make([]byte, fileSize-offset)
+				n, err := file.Read(newBytes)
+				if err != nil && err != io.EOF {
+					// If file changed (e.g., truncated), reopen.
+					file.Close()
+					file, err = os.OpenFile(filePath, os.O_RDONLY, 0644)
+					if err != nil {
+						continue
+					}
+					offset = 0
+					continue
+				}
+				if n > 0 {
+					// Write new content to os.Stdout.
+					os.Stdout.Write(newBytes[:n])
+					offset += int64(n)
+				}
+			}
+		}
+	}
+}
+
+// startLogForwarder starts a goroutine that tails the log file and writes
+// new lines to os.Stdout. It returns a channel that can be closed to stop
+// the forwarder.
+func startLogForwarder(ctx context.Context, filePath string, startOffset int64) (<-chan struct{}, error) {
+	stopCh := make(chan struct{})
+	go func() {
+		tailLogFile(filePath, startOffset, stopCh)
+	}()
+	return stopCh, nil
+}

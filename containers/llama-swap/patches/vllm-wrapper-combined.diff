+// extractModelName extracts the model name from the command arguments.
+// It looks for --served-model-name <name> in the args first.
+// If not found, it falls back to the basename of the model directory path.
+func extractModelName(args []string) string {
+	for i, arg := range args {
+		if arg == "--served-model-name" && i+1 < len(args) {

+// backendLivenessInterval is how often the liveness monitor polls the
+// backend's health endpoint once the proxy is up and serving.
+const backendLivenessInterval = 5 * time.Second
+
+// backendLivenessFailureThreshold is the number of consecutive failed health
+// checks required before the liveness monitor concludes the backend has
+// died and exits the wrapper. Set well above 1 to tolerate a handful of
+// transient blips (e.g. a slow request holding up the event loop) without
+// mistaking them for a crash.
+const backendLivenessFailureThreshold = 3
+
+// monitorBackendLiveness periodically polls the vLLM backend's health
+// endpoint and exits the wrapper process if the backend stops responding.
+//
+// This closes a gap where a crashed backing vLLM process (e.g. the
+// UR_RESULT_ERROR_DEVICE_LOST crash on inference requests, see the
+// llama-swap README's "Sleep mode compatibility investigation") left the
+// vllm-wrapper proxy itself running and answering its own listener, so
+// llama-swap kept reporting the model as loaded and proxied every request
+// straight into 502s indefinitely. llama-swap's only mechanism for
+// detecting an upstream failure is its own cmd.Wait() on the process it
+// spawned (vllm-wrapper) — it has no visibility into vllm-wrapper's
+// backend. By exiting here, llama-swap's existing "upstream process exited
+// unexpectedly" handling (internal/process/process_command.go) takes over
+// and the model correctly transitions back to Stopped, where a subsequent
+// request will restart it from scratch.
+//
+// A sleeping backend still answers its health endpoint (see isSleeping's
+// doc comment — /health and /is_sleeping remain reachable while sleeping),
+// so this monitor does not need to special-case sleep state: only an
+// actually-dead process (connection refused) or a backend stuck answering
+// non-200 for multiple consecutive checks trips it.
+func monitorBackendLiveness(ctx context.Context, vllmURL string, healthPath string) {
+	runLivenessLoop(ctx, backendLivenessInterval, func() error {
+		return checkHealthy(vllmURL, healthPath)
+	}, func(consecutiveFailures int) {
+		log.Fatalf("Backend at %s is unreachable after %d consecutive checks — exiting so llama-swap can restart the model",
+			vllmURL, consecutiveFailures)
+	})
+}
+
+// runLivenessLoop drives the poll/count/trip logic for monitorBackendLiveness
+// without any dependency on the network or on log.Fatalf, so the
+// failure-counting behavior (reset-on-success, trip-at-threshold) can be
+// unit tested directly. check is called once per tick; onDead is invoked
+// exactly once, when the failure threshold is first reached, after which
+// the loop returns (mirroring the real monitor's log.Fatalf exiting the
+// process — there is nothing further to do once onDead fires).
+func runLivenessLoop(ctx context.Context, interval time.Duration, check func() error, onDead func(consecutiveFailures int)) {
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+
+	consecutiveFailures := 0
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			if err := check(); err != nil {
+				consecutiveFailures++
+				log.Printf("Warning: backend liveness check failed (%d/%d): %v",
+					consecutiveFailures, backendLivenessFailureThreshold, err)
+				if consecutiveFailures >= backendLivenessFailureThreshold {
+					onDead(consecutiveFailures)
+					return
+				}
+			} else {
+				consecutiveFailures = 0
+			}
+		}
+	}
+}
+
+// isSleeping checks whether the vLLM daemon is in a sleeping state.
+// Returns (true, nil) if sleeping, (false, nil) if not sleeping.
+// Returns (false, error) if the endpoint is unavailable (e.g. legacy
+// daemon without sleep mode — we assume it is not sleeping since it can't
+// be put to sleep without --enable-sleep-mode + dev mode).
+func isSleeping(vllmURL string) (bool, error) {
+	resp, err := http.Get(vllmURL + "/is_sleeping")
+	if err != nil {
+		return false, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return false, fmt.Errorf("unexpected status code: %d", resp.StatusCode)
+	}
+
+	var result struct {
+		IsSleeping bool `json:"is_sleeping"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return false, err
+	}
+	return result.IsSleeping, nil
+}
+
+// wakeUpLevel2 performs the level-2 wake sequence:
+//  1. wake_up(tags=["weights"]) — re-allocate weight tensors
+//  2. reload_weights — re-read weights from the model source (PVC)
+//  3. wake_up(tags=["kv_cache"]) — re-allocate KV cache
+//
+// This is the full level-2 wake sequence required when vLLM was put to
+// sleep at level 2 (weights discarded on eviction).
+func wakeUpLevel2(vllmURL string) error {
+	// Step 1: Wake up weight memory only.
+	log.Printf("wake_up(tags=weights)")
+	if err := wakeUpTags(vllmURL, "weights"); err != nil {
+		return fmt.Errorf("wake_up weights failed: %w", err)
+	}
+
+	// Step 2: Reload weights from model source (PVC).
+	log.Printf("reload_weights from PVC")
+	if err := reloadWeights(vllmURL); err != nil {
+		return fmt.Errorf("reload_weights failed: %w", err)
+	}
+
+	// Step 3: Wake up KV cache.
+	log.Printf("wake_up(tags=kv_cache)")
+	if err := wakeUpTags(vllmURL, "kv_cache"); err != nil {
+		return fmt.Errorf("wake_up kv_cache failed: %w", err)
+	}
+
+	return nil
+}
+
+// wakeUpTags sends a POST to /wake_up with optional tags to selectively
+// wake only certain memory allocations (e.g. "weights" or "kv_cache").
+func wakeUpTags(vllmURL string, tags string) error {
+	resp, err := http.Post(vllmURL+"/wake_up?tags="+tags, "application/json", strings.NewReader(""))
+	if err != nil {
+		return fmt.Errorf("failed to POST /wake_up?tags=%s: %w", tags, err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusNoContent {
+		return fmt.Errorf("/wake_up?tags=%s returned unexpected status %d: %s", tags, resp.StatusCode, resp.Status)
+	}
+	return nil
+}
+
+// reloadWeights triggers a collective RPC to reload model weights from the
+// PVC. This is the key step that converts a level-2 sleep (weights discarded)
+// into a fully functional model — without it the engine would serve garbage.
+func reloadWeights(vllmURL string) error {
+	body := []byte(`{"method":"reload_weights"}`)
+	resp, err := http.Post(vllmURL+"/collective_rpc", "application/json", bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("failed to POST /collective_rpc: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode == http.StatusNotFound {
+		// Daemon doesn't support /collective_rpc (legacy or no dev mode).
+		// Best-effort: log and continue. The engine will not have valid weights,
+		// but this branch is only reached when a level-2 wake is expected.
+		log.Printf("Warning: /collective_rpc not available — weights may be empty (legacy daemon)")
+		return nil
+	}
+	if resp.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(resp.Body)
+		return fmt.Errorf("/collective_rpc returned status %d: %s", resp.StatusCode, string(body))
+	}
+
+	// Read and log the response body.
+	result, _ := io.ReadAll(resp.Body)
+	log.Printf("reload_weights response: %s", string(result))
+	return nil
+}

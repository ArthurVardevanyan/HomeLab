+// TestRunLivenessLoopTripsAtThreshold is a regression test for the
+// vllm-wrapper health-check masking bug: previously nothing monitored the
+// backing vLLM process after startup, so a crashed backend left the wrapper
+// proxy running and llama-swap reporting the model as loaded indefinitely
+// (see the llama-swap README's "Sleep mode compatibility investigation").
+// runLivenessLoop must trip onDead only after backendLivenessFailureThreshold
+// consecutive check failures, not on the first failure (tolerating a
+// transient blip), and must not trip at all on success.
+func TestRunLivenessLoopTripsAtThreshold(t *testing.T) {
+	var calls int32
+	var died bool
+	var diedAtFailures int
+
+	check := func() error {
+		n := atomic.AddInt32(&calls, 1)
+		if n <= 2 {
+			return fmt.Errorf("simulated backend failure %d", n)
+		}
+		// 3rd call succeeds — must reset the failure counter.
+		return nil
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	done := make(chan struct{})
+	go func() {
+		runLivenessLoop(ctx, 5*time.Millisecond, check, func(n int) {
+			died = true
+			diedAtFailures = n
+		})
+		close(done)
+	}()
+
+	// Let it run through several intermittent-failure/success cycles.
+	// With a reset on success, onDead must never fire here.
+	time.Sleep(100 * time.Millisecond)
+	cancel()
+	<-done
+
+	if died {
+		t.Errorf("onDead fired after %d consecutive failures, but successes should have reset the counter", diedAtFailures)
+	}
+}
+
+// TestRunLivenessLoopTripsOnSustainedFailure verifies the monitor exits
+// exactly once, exactly at the configured threshold, when the backend never
+// recovers (the real crash scenario — no more successes after the crash).
+func TestRunLivenessLoopTripsOnSustainedFailure(t *testing.T) {
+	check := func() error {
+		return fmt.Errorf("connection refused")
+	}
+
+	var diedAtFailures int
+	onDead := func(n int) { diedAtFailures = n }
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	done := make(chan struct{})
+	go func() {
+		runLivenessLoop(ctx, 5*time.Millisecond, check, onDead)
+		close(done)
+	}()
+
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("runLivenessLoop did not trip onDead within timeout")
+	}
+
+	if diedAtFailures != backendLivenessFailureThreshold {
+		t.Errorf("expected onDead to fire at exactly %d consecutive failures, got %d",
+			backendLivenessFailureThreshold, diedAtFailures)
+	}
+}

# llama-swap orchestrator for Intel Arc Pro B70 (Battlemage / Xe2) with SYCL
#
# Base: ghcr.io/mostlygeek/llama-swap
# renovate: datasource=docker depName=ghcr.io/mostlygeek/llama-swap versioning=loose
FROM ghcr.io/mostlygeek/llama-swap:v251-intel-b10711@sha256:1ba4ee9b4d4ac46d185e14fdabd782b71fd1fc31488122f576c4f04e9d461c6d

LABEL org.opencontainers.image.source="https://github.com/ArthurVardevanyan/HomeLab" \
  org.opencontainers.image.title="llama-swap SYCL (Battlemage)" \
  org.opencontainers.image.description="llama-swap orchestrator with SYCL/intel llama.cpp backend for Intel Arc Pro B70" \
  org.opencontainers.image.licenses="MIT"

USER 0

# ca-certificates (intel-compute-runtime already included in the mostlygeek
# intel base image)
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates; \
  rm -rf /var/lib/apt/lists/* /tmp/*

# Arbitrary-UID friendliness on OpenShift: HF cache to /tmp
ENV XDG_CACHE_HOME=/tmp

# Default SYCL env vars (per-model overrides apply at runtime)
ENV ONEAPI_DEVICE_SELECTOR=level_zero:* \
  SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=0 \
  SYCL_DEVICE_FILTER=level_zero \
  ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE

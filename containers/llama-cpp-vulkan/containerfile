# llama.cpp Vulkan server for the Intel Arc Pro B70 (Battlemage / Xe2), with
# Mesa upgraded to >= 26.1 via the kisak-mesa PPA.
#
# Why: the upstream ghcr.io/ggml-org/llama.cpp:server-vulkan image ships Mesa
# 26.0.3. Mesa 26.1 enabled the Intel ANV cooperative-matrix Vulkan path that
# roughly DOUBLES llama.cpp decode throughput on Battlemage. Mesa is a runtime
# driver, so we only swap it in on top of the prebuilt server (no source build).
#
# renovate: datasource=docker depName=ghcr.io/ggml-org/llama.cpp versioning=regex:^server-vulkan-b(?<major>\d+)$
FROM ghcr.io/ggml-org/llama.cpp:server-vulkan-b10331@sha256:3dd0b326c9899cf7a7491fcafba51f54e78af2a366953769a847dd380a732420

LABEL org.opencontainers.image.source="https://github.com/ArthurVardevanyan/HomeLab" \
  org.opencontainers.image.title="llama.cpp Vulkan (Mesa 26.1, Battlemage)" \
  org.opencontainers.image.description="llama.cpp Vulkan server with Mesa >= 26.1 (kisak-mesa) for Intel Arc Pro B70 coopmat path" \
  org.opencontainers.image.licenses="MIT"

USER 0

RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
  ca-certificates gnupg software-properties-common; \
  # kisak-mesa PPA -> Mesa 26.1.x (Battlemage coopmat path)
  add-apt-repository -y ppa:kisak/kisak-mesa; \
  apt-get update; \
  apt-get install -y --only-upgrade \
  mesa-vulkan-drivers libvulkan1 libgbm1 libgl1-mesa-dri libglx-mesa0; \
  # trim build-only tooling
  apt-get purge -y software-properties-common; \
  apt-get autoremove -y; \
  rm -rf /var/lib/apt/lists/* /tmp/*

# Arbitrary-UID friendliness on OpenShift: Mesa shader cache + HF cache to /tmp.
ENV XDG_CACHE_HOME=/tmp \
  MESA_SHADER_CACHE_DIR=/tmp

# Keep the upstream entrypoint (/app/llama-server).

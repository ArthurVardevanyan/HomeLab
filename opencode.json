{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "openshift-mcp": {
        "type": "remote",
        "url": "https://mcp.okd.homelab.arthurvardevanyan.com/mcp",
        "oauth": {
          "clientId": "398456311055988503",
          "scope": "openid profile email offline_access"
        }
      },
      "kubernetes-microshift": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "kubernetes-mcp-server@0.0.67",
          "--read-only",
          "--disable-multi-cluster",
          "--kubeconfig",
          "{env:HOME}/.kube/microshift"
        ]
      },
      "scafctl": {
        "type": "local",
        "command": ["scafctl", "mcp", "serve"]
      },
      "redhat-docs": {
        "type": "remote",
        "url": "https://docs-mcp.api.redhat.com/mcp"
      }
    }
  }
}

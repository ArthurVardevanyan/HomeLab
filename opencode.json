{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "openshift-mcp": {
      "type": "remote",
      "url": "https://mcp.okd.homelab.arthurvardevanyan.com/mcp",
      "enabled": false,
      "oauth": {
        "client_id": "398456311055988503",
        "client_secret": "{env:OPENSHIFT_MCP_CLIENT_SECRET}",
        "redirect_uri": "http://127.0.0.1:19876/mcp/oauth/callback",
        "callback_port": 19876
      }
    },
    "kubernetes-microshift": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@0.0.67",
        "--read-only",
        "--disable-multi-cluster",
        "--kubeconfig",
        "{env:HOME}/.kube/microshift"
      ],
      "enabled": false
    },
    "scafctl": {
      "type": "local",
      "command": ["scafctl", "mcp", "serve"],
      "enabled": false
    },
    "redhat-docs": {
      "type": "remote",
      "url": "https://docs-mcp.api.redhat.com/mcp",
      "enabled": false
    }
  }
}

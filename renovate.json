{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "MCP server npm packages pinned via npx args (scafctl mcp configs under machineConfigs)",
      "managerFilePatterns": ["/machineConfigs/.*/(mcp|opencode)\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)?)@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["containers/**"],
      "groupName": "Homelab Container Images",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["terraform/**"],
      "groupName": "Homelab Terraform",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["ansible/**"],
      "groupName": "Homelab Ansible",
      "separateMajorMinor": false
    }
  ]
}

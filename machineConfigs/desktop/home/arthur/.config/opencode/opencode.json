{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": false
    // "reserved": 12000
  },
  "provider": {
    "nerdheroes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NerdHeroes",
      "options": {
        "baseURL": "{env:NERDHEROES_BASE_URL}"
      },
      "models": {
        "Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf": {
          "name": "Qwen3.6-35B-A3B (NerdHeroes)",
          "limit": {
            "context": 256000,
            "output": 256000
          }
        },
        "local.qwen3.6:27b-q8_0": {
          "name": "Qwen3.6 27B (NerdHeroes)",
          "limit": {
            "context": 200000,
            "output": 200000
          }
        },
        "local.qwen3.5:35b-a3b-q8_0": {
          "name": "Qwen3.5 35B (NerdHeroes)",
          "limit": {
            "context": 200000,
            "output": 200000
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "options": {
        "baseURL": "http://10.101.10.246:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "qwen3.5:9b",
          "limit": {
            "context": 49152,
            "input": 40960,
            "output": 8192
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder-30B (Intel Arc B70)",
          "limit": {
            "context": 49152,
            "input": 40960,
            "output": 8192
          }
        }
      }
    },
    "anthropic": {
      "name": "Anthropic",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5"
        }
      }
    }
  },
  "model": "nerdheroes/local.qwen3.6:27b-q8_0",
  "agent": {
    "plan": {
      "description": "High-level architectural planning. Routed directly to Claude Opus 5 (Anthropic).",
      "model": "anthropic/claude-opus-5",
      "temperature": 0.2
    },
    "build": {
      "description": "Token-heavy code generation. Routed to local Qwen3-Coder-30B on the single Intel Arc B70 via Ollama.",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.1
    },
    "explore": {
      "description": "Fast codebase scouting/diagnostics. On the single-GPU setup this shares the same local model as build.",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.0
    }
  },
  "mcp": {
    "kubernetes-okd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@0.0.66",
        "--read-only",
        "--disable-multi-cluster",
        "--kubeconfig",
        "{env:HOME}/.kube/okd"
      ],
      "enabled": true
    },
    "kubernetes-microshift": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@0.0.66",
        "--read-only",
        "--disable-multi-cluster",
        "--kubeconfig",
        "{env:HOME}/.kube/microshift"
      ],
      "enabled": true
    },
    "scafctl": {
      "type": "local",
      "command": ["scafctl", "mcp", "serve"],
      "enabled": true
    }
  }
}

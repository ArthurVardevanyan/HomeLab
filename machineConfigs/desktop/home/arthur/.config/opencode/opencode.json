          },
          "limit": {
            "context": 163840,
            "input": 155648,
            "output": 8192
          }
        },
        "qwen3.6-35b-a3b-dense": {
          "name": "Qwen3.6 35B-A3B MoE (Dense)",
          "cost": {
            "input": 1.35,
            "output": 1.35
          },
          "limit": {
            "context": 262144,
            "input": 253952,
            "output": 8192
          }
        },

        "qwen3.8-27b": {
          "name": "Qwen3.8 27B Dense",
          "cost": {
            "input": 1.18,
            "output": 1.18
          },
          "limit": {
            "context": 196608,
            "input": 189440,
            "output": 8192
          }
        },
        "qwen3.6-35b-a3b-spread": {
          "name": "Qwen3.6 35B-A3B Spread",
          "cost": {
            "input": 0.77,
            "output": 0.77
          },
          "limit": {
            "context": 262144,
            "input": 260096,
            "output": 8192
          }
        }

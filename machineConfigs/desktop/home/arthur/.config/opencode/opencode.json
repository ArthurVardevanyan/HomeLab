{
  "$schema": "https://opencode.ai/config.json",
  // "plugin": ["opencode-snip@latest"],
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": false
  },
  "provider": {
    "llm": {
      "name": "Local LLM (Open WebUI)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.arthurvardevanyan.com/api"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B MoE",
          "cost": {
            "input": 0.013,
            "output": 0.013
          },
          "limit": {
            "context": 124000,
            "input": 120000,
            "output": 4000
          }
        },

        "qwen3.8-27b": {
          "name": "Qwen3.8 27B Dense",
          "cost": {
            "input": 0.013,
            "output": 0.013
          },
          "limit": {
            "context": 100000,
            "input": 96000,
            "output": 4000
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "cost": {
            "input": 2.0,
            "output": 10.0
          },
          "limit": {
            "context": 200000,
            "input": 183616,
            "output": 16384
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "cost": {
            "input": 5.0,
            "output": 25.0
          },
          "limit": {
            "context": 200000,
            "input": 183616,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "description": "High-level architectural planning.",
      "model": "llm/qwen3.6-35b-a3b",
      "temperature": 0.2
    },
    "build": {
      "description": "Code generation.",
      "model": "llm/qwen3.6-35b-a3b",
      "temperature": 0.1
    },
    "explore": {
      "description": "Fast codebase scouting/diagnostics.",
      "model": "llm/qwen3.6-35b-a3b",
      "temperature": 0.55
    }
  }
}

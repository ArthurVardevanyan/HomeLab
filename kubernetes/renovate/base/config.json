{
  "repositories": [
    "ArthurVardevanyan/ArthurVardevanyan-com",
    "ArthurVardevanyan/bmc-shim",
    "ArthurVardevanyan/FinanceTracker",
    "ArthurVardevanyan/Homelab",
    "ArthurVardevanyan/k8s-federated-credential-api",
    "ArthurVardevanyan/k8s-gitops-ci",
    "ArthurVardevanyan/kube-eagle",
    "ArthurVardevanyan/openshift-monitoring-cr-controller",
    "ArthurVardevanyan/Analytics-for-Spotify",
    "ArthurVardevanyan/wasm-wiretap"
  ],
  "gitAuthor": "homelab-okd[bot] <139566794+homelab-okd[bot]@users.noreply.github.com>",
  "automerge": false,
  "prHourlyLimit": 0,
  "postUpdateOptions": ["gomodTidy"],
  "ansible": {
    "enabled": false
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchFileNames": [".pre-commit-config.yaml"],
      "groupName": "Pre-commit Hooks",
      "separateMajorMinor": false
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "Container Updates"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "Go Modules",
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": true
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_provider"],
      "groupName": "Terraform Providers"
    },
    {
      "matchManagers": [
        "pip_requirements",
        "pip-compile",
        "pep621",
        "poetry",
        "pipenv",
        "custom.regex"
      ],
      "matchDatasources": ["pypi"],
      "groupName": "Python Dependencies",
      "separateMajorMinor": false
    },

    {
      "matchManagers": ["cargo"],
      "groupName": "Rust Crates"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/external-secrets/external-secrets"],
      "groupName": "External Secrets Operator"
    },
    {
      "matchDatasources": ["github-releases", "npm"],
      "matchManagers": ["custom.regex"],
      "groupName": "Regex-Managed Releases",
      "separateMajorMinor": false
    },
    {
      "matchFileNames": ["**/vm-cluster.yaml"],
      "groupName": "VictoriaMetrics Cluster Version"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.pre-commit-config.yaml$/"],
      "matchStrings": ["rev: v0\\.(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "shellcheck-py/shellcheck-py",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^v0\\.(?<version>.*)$",
      "autoReplaceStringTemplate": "rev: v0.{{{newVersion}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+(?:-\\s+)?\\w+:\\s+(?:[^@\\s]*:)?(?<currentValue>[^@\\s\"]+)(?:@(?<currentDigest>[\\w:]+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Ansible get_url / Dockerfile ENV pinned releases (github-releases, npm, pypi, docker, golang-version)",
      "managerFilePatterns": [
        "/^ansible/playbooks/.*\\.yaml$/",
        "/(^|/)Dockerfile$/",
        "/(^|/)Containerfile$/",
        "/(^|/)containerfile$/"
      ],
      "matchStrings": [
        "# renovate: custom-github-release depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\n\\s+url: .*?/releases/download/v?(?<currentValue>[^/]+)/",
        "# renovate: custom-github-release depName=(?<depName>[^\\s]+).*?\\n\\s+url: .*?_(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)_",
        "# renovate: custom-github-release depName=(?<depName>[^\\s]+).*?\\n\\s+url: .*?linux-(?:arm64-)?(?<currentValue>[\\w.-]+?)\\.tar\\.gz",
        "# renovate: (?:custom-github-release|datasource=(?<datasource>[a-z0-9-]+)) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\n\\s*(?:ENV )?[A-Z][A-Z0-9_]*=(?<currentValue>[^\\s\\\\]+)",
        "# renovate: datasource=(?<datasource>pypi) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\n\\s+-\\s+.*?==(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "kubernetes-sigs/kustomize (monorepo tags prefixed with kustomize/vX.Y.Z)",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)Containerfile$/",
        "/(^|/)containerfile$/"
      ],
      "matchStrings": [
        "# renovate: custom-github-release depName=(?<depName>kubernetes-sigs/kustomize)\\n\\s*ENV KUSTOMIZE_VERSION=(?<currentValue>[^\\s\\\\]+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^kustomize/v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update vm-cluster.yaml clusterVersion",
      "managerFilePatterns": ["/vm-cluster\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+clusterVersion:\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)-cluster$"
    },
    {
      "customType": "regex",
      "description": "Update ArgoCD manifests with SHA256 digests",
      "managerFilePatterns": ["/argocd\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+(?:-\\s+)?\\w+:\\s+(?<currentDigest>sha256:[a-f0-9]+)\\s*#\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "MCP server npm packages pinned via npx args (VS Code mcp.json, opencode.json)",
      "managerFilePatterns": [
        "/\\.vscode/mcp\\.json$/",
        "/(^|/)opencode\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)?)@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ]
}

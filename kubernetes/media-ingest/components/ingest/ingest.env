SECRET_MOUNT=/etc/secret
INGEST_SOURCES=import=umas-arthur:ingest/import
INGEST_DEST=umas-arthur:ingest/export
RC_MODE=QVBR
QP_TARGET=24
QVBR_QUALITY=24
B_DEPTH=3
INGEST_INTERVAL=900
INGEST_DISPATCH_INTERVAL=10
PIPELINES_PER_CARD=4
MAX_HEIGHT=2160
INGEST_FILE_TIMEOUT=21600
INGEST_CARD_CONTEST_GRACE=300
INGEST_CARD_COOLDOWN=900
INGEST_VRAM_PROBE_FAIL_LIMIT=12

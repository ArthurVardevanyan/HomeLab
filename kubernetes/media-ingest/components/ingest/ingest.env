SECRET_MOUNT=/etc/secret
INGEST_SOURCES=import=unas-arthur:ingest/import
INGEST_DEST=unas-arthur:ingest/export
RC_MODE=ICQ
ICQ_QUALITY_1440=33
ICQ_QUALITY_2160=35
ICQ_QUALITY_GOPRO=24
B_DEPTH=3
INGEST_INTERVAL=900
INGEST_DISPATCH_INTERVAL=10
PIPELINES_PER_CARD=4
MAX_HEIGHT=2160
INGEST_FILE_TIMEOUT=21600
INGEST_CARD_CONTEST_GRACE=300
INGEST_CARD_COOLDOWN=900
INGEST_VRAM_PROBE_FAIL_LIMIT=12
INGEST_MAX_ATTEMPTS=3

          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "llamaswap_profile_active",
          "legendFormat": "{{profile}}",
          "refId": "A"
        }
      ],
      "title": "Profile Activation",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "type": "bargauge"

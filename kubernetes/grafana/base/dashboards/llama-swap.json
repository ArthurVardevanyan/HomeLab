      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(llamaswap_http_requests_total[5m])",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "title": "Requests/sec by Status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
